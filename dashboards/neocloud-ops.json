            {
              "id": "dashletLineChart",
              "uuid": "0329282f-1812-50b7-bd5f-0dc59ec3d151",
              "name": "",
              "type": "dashletLineChart",
              "title": "GPU traffic per rail",
              "subtitle": "GPU ports of each rail leaf, both directions; draws while this page is open",
              "width": 600,
              "height": 350,
              "parentFlexType": "row",
              "fillWidth": true,
              "componentConfiguration": {
                "apiConfiguration": {
                  "api": ".namespace.node.srl.interface.traffic-rate fields [ .namespace.node.name as \"Key\", sum(in-bps) as \"In\", sum(out-bps) as \"Out\" ] where (.namespace.name = \"neocloud\" and (.namespace.node.name = \"rail-leaf-1\" or .namespace.node.name = \"rail-leaf-2\" or .namespace.node.name = \"rail-leaf-3\" or .namespace.node.name = \"rail-leaf-4\" or .namespace.node.name = \"rail-leaf-5\" or .namespace.node.name = \"rail-leaf-6\" or .namespace.node.name = \"rail-leaf-7\" or .namespace.node.name = \"rail-leaf-8\") and (.namespace.node.srl.interface.name = \"ethernet-1/1\" or .namespace.node.srl.interface.name = \"ethernet-1/2\" or .namespace.node.srl.interface.name = \"ethernet-1/3\" or .namespace.node.srl.interface.name = \"ethernet-1/4\")) sample milliseconds 2000",
                  "queryType": "eql",
                  "requestType": "get",
                  "dataTransformer": "const o = {};\n[...data].sort((a, b) => a.Key.localeCompare(b.Key, undefined, { numeric: true })).forEach(r => { o[r.Key.replace('rail-leaf-', 'Rail ')] = (Number(r.In) || 0) + (Number(r.Out) || 0); });\nreturn [o];"
                },
                "additionalConfiguration": {
                  "maxDataPoints": "150",
                  "yAxisUnits": "bps",
                  "scalingFunction": "metricPrefix"
                }
              }
            },
            {
              "id": "dashletLineChart",
              "uuid": "801aac6f-c539-5703-b217-f0d8983be58c",
              "name": "",
              "type": "dashletLineChart",
              "title": "E/W spine load (ECMP spread)",
              "subtitle": "Rail-facing ports of each E/W spine, both directions: even lines = traffic spread evenly over the 4 spines",
              "width": 600,
              "height": 350,
              "parentFlexType": "row",
              "fillWidth": true,
              "componentConfiguration": {
                "apiConfiguration": {
                  "api": ".namespace.node.srl.interface.traffic-rate fields [ .namespace.node.name as \"Key\", sum(in-bps) as \"In\", sum(out-bps) as \"Out\" ] where (.namespace.name = \"neocloud\" and (.namespace.node.name = \"ew-spine-1\" or .namespace.node.name = \"ew-spine-2\" or .namespace.node.name = \"ew-spine-3\" or .namespace.node.name = \"ew-spine-4\") and (.namespace.node.srl.interface.name = \"ethernet-1/1\" or .namespace.node.srl.interface.name = \"ethernet-1/2\" or .namespace.node.srl.interface.name = \"ethernet-1/3\" or .namespace.node.srl.interface.name = \"ethernet-1/4\" or .namespace.node.srl.interface.name = \"ethernet-1/5\" or .namespace.node.srl.interface.name = \"ethernet-1/6\" or .namespace.node.srl.interface.name = \"ethernet-1/7\" or .namespace.node.srl.interface.name = \"ethernet-1/8\")) sample milliseconds 2000",
                  "queryType": "eql",
                  "requestType": "get",
                  "dataTransformer": "const o = {};\n[...data].sort((a, b) => a.Key.localeCompare(b.Key, undefined, { numeric: true })).forEach(r => { o[r.Key.replace('ew-spine-', 'Spine ')] = (Number(r.In) || 0) + (Number(r.Out) || 0); });\nreturn [o];"
                },
                "additionalConfiguration": {
                  "maxDataPoints": "150",
                  "yAxisUnits": "bps",
                  "scalingFunction": "metricPrefix"
                }
              }
            }
          ]
